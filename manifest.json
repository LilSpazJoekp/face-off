{
  "_metadata": {
      "major_version": 1,
      "minor_version": 1
  },
  "display_information": {
      "name": "Face Off"
  },
  "features": {
      "app_home": {
          "home_tab_enabled": true,
          "messages_tab_enabled": false,
          "messages_tab_read_only_enabled": true
      },
      "bot_user": {
          "display_name": "Face Off",
          "always_online": false
      },
      "slash_commands": [
          {
              "command": "/trigger-poll",
              "description": "Manually trigger the profile picture poll",
              "should_escape": false
          },
          {
              "command": "/watched-users",
              "description": "Show users being watched for profile picture changes",
              "should_escape": false
          },
          {
              "command": "/manual-user-update",
              "description": "Manually trigger a profile picture update for a user",
              "usage_hint": "[@user]",
              "should_escape": false
          }
      ]
  },
  "oauth_config": {
      "scopes": {
          "bot": [
              "channels:history",
              "channels:join",
              "chat:write",
              "commands",
              "users:read",
              "reactions:write"
          ]
      }
  },
  "settings": {
      "event_subscriptions": {
          "bot_events": [
              "app_home_opened",
              "message.channels",
              "user_change"
          ]
      },
      "interactivity": {
          "is_enabled": true
      },
      "org_deploy_enabled": true,
      "socket_mode_enabled": true,
      "token_rotation_enabled": false
  }
}
